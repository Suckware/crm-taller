{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SMS Taller",
  "version": "1.0.0",
  "identifier": "app.sergiomotosport.taller",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Suckware",
    "shortDescription": "Gestión del taller",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["Spanish"], "installMode": "currentUser" },
      "wix": { "language": "es-ES" }
    }
  }
}
